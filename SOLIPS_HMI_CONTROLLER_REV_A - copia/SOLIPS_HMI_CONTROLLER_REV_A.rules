
(rules PCB SOLIPS_HMI_CONTROLLER_REV_A.dsn
  (snapAngle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default
  )
  (viaRule
    default "Via[0-3]_600:300_um"
  )
  (viaRule
    default "Via[0-3]_600:300_um"
  )
  (class default
    +3V3 GND "/02_USB_UART/USB_5V" "/03_MCu/MCU_NRST" "/02_USB_UART/USB_UART_RTS" "Net-(J3-SHIELD)" "/03_MCu/MCU_BOOT0" "/02_USB_UART/USB_DP_RAW"
    "/02_USB_UART/USB_DM_RAW" "/02_USB_UART/USB_DM" "/02_USB_UART/USB_DP" "/03_MCu/MCU_SWDIO" "Net-(U2-VDD)" "Net-(J3-CC1)" "unconnected-(U2-~{RI}-Pad1)" "Net-(U2-VBUS)"
    "Net-(U2-~{RST})" "unconnected-(U2-NC-Pad10)" "unconnected-(U2-NC-Pad11)" "unconnected-(U2-NC-Pad12)" "unconnected-(U2-NC-Pad13)" "unconnected-(U2-NC-Pad14)" "unconnected-(U2-~{SUSPEND}-Pad15)" "unconnected-(U2-NC-Pad16)"
    "unconnected-(U2-SUSPEND-Pad17)" "unconnected-(U2-~{CTS}-Pad18)" "/02_USB_UART/MCU_UART_TX" "/02_USB_UART/MCU_UART_RX" "unconnected-(U2-~{DSR}-Pad22)" "/02_USB_UART/USB_UART_DTR" "unconnected-(U2-~{DCD}-Pad24)" "Net-(U1-VCAP)"
    "unconnected-(U1-PC13-Pad2)" "unconnected-(U1-PC14-Pad3)" "unconnected-(U1-PC15-Pad4)" "unconnected-(U1-PH0-Pad5)" "unconnected-(U1-PH1-Pad6)" "unconnected-(U1-PA0-Pad10)" "unconnected-(U1-PA1-Pad11)" "unconnected-(U1-PA2-Pad12)"
    "unconnected-(U1-PA3-Pad13)" "unconnected-(U1-PA4-Pad14)" "/03_MCu/TFT_SCK" "unconnected-(U1-PA6-Pad16)" "/03_MCu/TFT_MOSI" "/03_MCu/TFT_CS" "/03_MCu/TFT_DC" "/03_MCu/TFT_RST"
    "unconnected-(U1-PB10-Pad21)" "unconnected-(U1-PB12-Pad25)" "unconnected-(U1-PB13-Pad26)" "unconnected-(U1-PB14-Pad27)" "unconnected-(U1-PB15-Pad28)" "unconnected-(U1-PA8-Pad29)" "unconnected-(U1-PA11-Pad32)" "unconnected-(U1-PA12-Pad33)"
    "unconnected-(U1-PA15-Pad38)" "unconnected-(U1-PB3-Pad39)" "unconnected-(U1-PB4-Pad40)" "unconnected-(U1-PB5-Pad41)" "unconnected-(U1-PB6-Pad42)" "unconnected-(U1-PB7-Pad43)" "unconnected-(U1-PB8-Pad45)" "unconnected-(U1-PB9-Pad46)"
    "Net-(J3-CC2)" "unconnected-(U4-NC-Pad4)" "unconnected-(J3-SBU1-PadA8)" "unconnected-(J3-SBU2-PadB8)"
    (clearance_class default)
    (via_rule default)
    (rule
